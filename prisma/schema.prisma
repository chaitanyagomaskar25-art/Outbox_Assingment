datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  ENQUEUED
  FAILED
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  name            String?
  avatarUrl       String?
  googleId        String?            @unique
  passwordHash    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  senders         EmailSender[]
  scheduledEmails ScheduledEmail[]
  slackIntegrations SlackIntegration[]
  idempotencyRecords IdempotencyRecord[]

  @@map("users")
}

model EmailSender {
  id              String             @id @default(uuid())
  userId          String
  name            String
  email           String
  host            String             @default("smtp.ethereal.email")
  port            Int                @default(587)
  secure          Boolean            @default(false)
  username        String?
  password        String?
  isDefault       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledEmails ScheduledEmail[]
  hourlyUsages    HourlyRateLimitUsage[]

  @@index([userId])
  @@map("email_senders")
}

model ScheduledEmail {
  id                 String       @id @default(uuid())
  userId             String
  senderId           String
  recipientEmail     String
  subject            String
  body               String
  scheduledAt        DateTime
  nextEligibleAt     DateTime     @default(now())
  status             EmailStatus  @default(SCHEDULED)
  attemptCount       Int          @default(0)
  maxAttempts        Int          @default(3)
  providerMessageId  String?
  etherealPreviewUrl String?
  sentAt             DateTime?
  failedAt           DateTime?
  errorDetails       String?
  idempotencyKey     String?
  bullJobId          String?
  batchId            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender             EmailSender  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([senderId, nextEligibleAt])
  @@index([scheduledAt])
  @@index([idempotencyKey])
  @@index([bullJobId])
  @@unique([userId, idempotencyKey])
  @@map("scheduled_emails")
}

model EmailOutbox {
  id         String       @id @default(uuid())
  emailId    String       @unique
  payload    Json
  status     OutboxStatus @default(PENDING)
  retries    Int          @default(0)
  lastError  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, createdAt])
  @@map("email_outbox")
}

model HourlyRateLimitUsage {
  id          String      @id @default(uuid())
  senderId    String
  windowStart DateTime
  emailCount  Int         @default(0)
  updatedAt   DateTime    @updatedAt

  sender      EmailSender @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, windowStart])
  @@index([senderId, windowStart])
  @@map("hourly_rate_limit_usage")
}

model SlackIntegration {
  id                 String   @id @default(uuid())
  userId             String
  teamId             String
  teamName           String
  channelId          String?
  channelName        String?
  botAccessToken     String
  incomingWebhookUrl String?
  authedUserId       String?
  scope              String?
  isConnected        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@map("slack_integrations")
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  userId         String
  key            String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, key])
  @@map("idempotency_records")
}
