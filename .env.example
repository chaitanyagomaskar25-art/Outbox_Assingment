# ==============================================================================
# ReachInbox Full-Stack Email Job Scheduler — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5175

# Application Session & Security
# Generate a strong 32+ character random string for production
SESSION_SECRET=reachinbox_super_secret_session_key_min_32_chars_long_123456
JWT_SECRET=reachinbox_jwt_secret_token_key_change_in_production_987654

# PostgreSQL Database (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/reachinbox?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reachinbox
POSTGRES_PORT=5433

# Redis (BullMQ, Rate Limits, Coordination)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Elasticsearch (Email indexing & search)
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=reachinbox-emails

# Worker & Scheduler Configuration
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
OUTBOX_SWEEPER_INTERVAL_MS=10000

# Ethereal Email SMTP (Fake SMTP for local testing)
# You can leave user/pass empty during initial dev to auto-generate a fresh test account
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_SECURE=false
ETHEREAL_USER=
ETHEREAL_PASS=
DEFAULT_SENDER_NAME="ReachInbox Scheduler"
DEFAULT_SENDER_EMAIL="outreach@reachinbox.test"

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Slack OAuth 2.0 & App Credentials
# Obtain from Slack API: https://api.slack.com/apps -> OAuth & Permissions
# Scopes: chat:write, incoming-webhook, channels:read
# Authorized Redirect URL: http://localhost:5000/api/integrations/slack/callback
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/integrations/slack/callback
SLACK_SIGNING_SECRET=your_slack_signing_secret

# BullMQ Dashboard Admin Access
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=admin

